    "AuraVoice Kayıt": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسجيل AuraVoice"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "AuraVoice রেকর্ডিং"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AuraVoice Recording"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Grabación AuraVoice"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrement AuraVoice"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "AuraVoice रिकॉर्डिंग"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AuraVoice Kayıt"
          }
        },
        "zh-Hans": {
          "stringUnit": {

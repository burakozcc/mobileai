    "Kaydı Başlat": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدء التسجيل"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রেকর্ডিং শুরু করুন"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start Recording"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar grabación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrer l’enregistrement"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्डिंग शुरू करें"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydı Başlat"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始录音"
          }
        }
      }
    },
    "Kaydı cihaz içinde işlenecek şekilde başlatır.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدأ التسجيل بحيث تتم معالجته على الجهاز."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এমনভাবে রেকর্ডিং শুরু করে যাতে তা ডিভাইসেই প্রসেস হয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starts a recording that is processed on device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia una grabación que se procesa en el dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarre un enregistrement traité sur l’appareil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्डिंग शुरू करता है, जिसकी प्रोसेसिंग डिवाइस पर ही होती है।"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydı cihaz içinde işlenecek şekilde başlatır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始录音，音频将在设备端处理。"
          }
        }
      }
    },
    "Kaydı tamamen cihaz içinde işlenecek şekilde başlatır.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدأ التسجيل بحيث تتم معالجته بالكامل على الجهاز."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এমনভাবে রেকর্ডিং শুরু করে যাতে সবকিছু সম্পূর্ণ ডিভাইসেই প্রসেস হয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starts a recording that is processed entirely on device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia una grabación que se procesa por completo en el dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarre un enregistrement traité entièrement sur l’appareil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्डिंग शुरू करता है, जिसकी प्रोसेसिंग पूरी तरह डिवाइस पर ही होती है।"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydı tamamen cihaz içinde işlenecek şekilde başlatır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始录音，音频将完全在设备端处理。"
          }
        }
      }
    },

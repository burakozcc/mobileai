            "value": "AuraVoice 录音"
          }
        }
      }
    },
    "AuraVoice'u açar ve kayıt ekranını hazırlar.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح AuraVoice ويجهّز شاشة التسجيل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "AuraVoice খোলে এবং রেকর্ডিং স্ক্রিন প্রস্তুত করে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens AuraVoice and gets the recording screen ready."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre AuraVoice y prepara la pantalla de grabación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre AuraVoice et prépare l’écran d’enregistrement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "AuraVoice खोलता है और रिकॉर्डिंग स्क्रीन तैयार करता है।"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AuraVoice'u açar ve kayıt ekranını hazırlar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 AuraVoice 并准备好录音界面。"
          }
        }
      }
    },
    "Kalan Dakika": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الدقائق المتبقية"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বাকি মিনিট"
          }
        },
        "en": {
          "stringUnit": {

            "value": "Minutes restantes"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बचे हुए मिनट"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalan Dakika"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剩余分钟"
          }
        }
      }
    },
    "Kalan kayıt dakikanı gösterir, tek dokunuşla kayda başlar.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض دقائق التسجيل المتبقية ويبدأ التسجيل بلمسة واحدة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার বাকি রেকর্ডিং মিনিট দেখায়, এক ট্যাপেই রেকর্ডিং শুরু করে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows your remaining recording minutes and starts a recording with one tap."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra tus minutos de grabación restantes y empieza a grabar con un solo toque."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche vos minutes d’enregistrement restantes et démarre un enregistrement d’un simple toucher."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके बचे हुए रिकॉर्डिंग मिनट दिखाता है और एक टैप में रिकॉर्डिंग शुरू करता है।"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalan kayıt dakikanı gösterir, tek dokunuşla kayda başlar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示剩余录音分钟数，轻点即可开始录音。"
          }
        }
      }
    },
    "Kaydet": {

    "%lld": {
      "comment": "Kota halkasinin ortasindaki kalan dakika. remainingMinutes Double, Int(...) ile sarili -> %lld dogru. Turkce sozcuk yok; katalogda girdi olusur ama ceviri metni gerekmez (tum dillerde \"%lld\")",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld"
          }
        },
        "bn": {
          "stringUnit": {

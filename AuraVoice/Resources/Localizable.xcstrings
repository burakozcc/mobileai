            "value": "Aún no hay grabaciones. Toca el botón de grabación para empezar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun enregistrement pour l’instant. Touchez le bouton d’enregistrement pour commencer."

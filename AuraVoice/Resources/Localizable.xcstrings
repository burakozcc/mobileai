    "Bilet biçimi bu sürüm tarafından desteklenmiyor. Uygulamayı güncelleyin.": {
      "comment": "Hata metni. USLUP TUTARSIZLIGI: uygulamadaki tek 'siz' hitabi ('güncelleyin'); diger tum metinler 'sen' diyor ('dene', 'indir', 'geçebilirsin'). Kaynak Turkce duzeltilmeden cevrilirse tutarsizlik 7 dile kopyalanir.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنسيق التذكرة غير مدعوم في هذا الإصدار. حدّث التطبيق."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই সংস্করণ টিকিটের ফরম্যাট সমর্থন করে না। অ্যাপটি আপডেট করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This version doesn't support the ticket format. Update the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versión no admite el formato del cupón. Actualiza la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce format de ticket n’est pas pris en charge par cette version. Mettez l’app à jour."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टिकट का फ़ॉर्मैट इस वर्शन में सपोर्ट नहीं है। ऐप अपडेट करें।"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilet biçimi bu sürüm tarafından desteklenmiyor. Uygulamayı güncelleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本不支持该券码格式。请更新应用。"
          }
        }
      }
    },

    "Kayıt notlarına kaydedildi, sesi duruyor. İstediğin zaman tekrar deneyebilirsin.": {
      "comment": "Hata panelinde güven verici açıklama satırı",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حُفظ التسجيل في الملاحظات، والصوت ما زال موجودًا. يمكنك المحاولة مرة أخرى وقتما تشاء."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রেকর্ডিংটি নোটে সংরক্ষিত হয়েছে, অডিও রয়ে গেছে। যখন খুশি আবার চেষ্টা করতে পারেন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recording is saved in your notes, and the audio is still there. You can try again anytime."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación se ha guardado en tus notas, el audio sigue ahí. Puedes volver a intentarlo cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistré dans vos notes, l’audio est conservé. Vous pouvez réessayer quand vous voulez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्डिंग नोट्स में सेव हो गई, ऑडियो अब भी मौजूद है। जब चाहें फिर कोशिश कर सकते हैं।"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt notlarına kaydedildi, sesi duruyor. İstediğin zaman tekrar deneyebilirsin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音已保存到笔记中，音频仍然保留。随时可以重试。"
          }
        }
      }
    },
    "Kayıt silinsin mi?": {

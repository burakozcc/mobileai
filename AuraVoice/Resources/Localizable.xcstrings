    "Dakika bakiyen güvenli depoya yazılamadı. Cihazı yeniden başlatıp tekrar dene.": {
      "comment": "AuraError hata metni; String(localized:) ile sarili.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذرت كتابة رصيد دقائقك في المخزن الآمن. أعد تشغيل الجهاز ثم حاول مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার মিনিট ব্যালেন্স সুরক্ষিত স্টোরেজে সংরক্ষণ করা যায়নি। ডিভাইস আবার চালু করে চেষ্টা করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your minute balance couldn't be written to secure storage. Restart your device and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido guardar tu saldo de minutos en el almacenamiento seguro. Reinicia el dispositivo e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’écrire votre solde de minutes dans le stockage sécurisé. Redémarrez l’appareil et réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका मिनट बैलेंस सुरक्षित स्टोरेज में सेव नहीं हो सका। डिवाइस रीस्टार्ट करके फिर कोशिश करें।"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dakika bakiyen güvenli depoya yazılamadı. Cihazı yeniden başlatıp tekrar dene."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分钟余额无法写入安全存储。请重启设备后重试。"
          }
        }
      }
    },

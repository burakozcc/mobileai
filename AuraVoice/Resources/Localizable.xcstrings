            "state": "translated",
            "value": "সাবস্ক্রিপশন পরিচালনা করুন"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manage subscription"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestionar la suscripción"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gérer l’abonnement"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सब्सक्रिप्शन मैनेज करें"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aboneliği yönet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "管理订阅"
          }
        }
      }
    },

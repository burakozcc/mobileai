    "Başka bir uygulama mikrofonu aldı. Devam etmek için oynat tuşuna bas ya da kaydı bitir.": {
      "comment": "Kesinti uyarı şeridinin açıklaması",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استحوذ تطبيق آخر على الميكروفون. اضغط زر التشغيل للمتابعة أو أنهِ التسجيل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অন্য একটি অ্যাপ মাইক্রোফোন নিয়ে নিয়েছে। চালিয়ে যেতে প্লে বোতামে চাপ দিন বা রেকর্ডিং শেষ করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another app took the microphone. Tap play to continue, or finish the recording."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otra app ha tomado el micrófono. Pulsa reproducir para continuar o finaliza la grabación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une autre app a pris le micro. Appuyez sur le bouton de lecture pour continuer ou terminez l’enregistrement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी दूसरे ऐप ने माइक्रोफ़ोन ले लिया। जारी रखने के लिए प्ले बटन दबाएँ या रिकॉर्डिंग खत्म करें।"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir uygulama mikrofonu aldı. Devam etmek için oynat tuşuna bas ya da kaydı bitir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他应用占用了麦克风。轻点播放按钮继续，或结束录音。"
          }
        }
      }
    },

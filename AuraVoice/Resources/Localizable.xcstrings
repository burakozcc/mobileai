    "Offline mod için model indirilmeli": {
      "comment": "Satır alt yazısı — model kurulu değil",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب تنزيل النموذج للوضع دون اتصال"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অফলাইন মোডের জন্য মডেল ডাউনলোড করতে হবে"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Model download required for Offline mode"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay que descargar el modelo para el modo sin conexión"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modèle à télécharger pour le mode hors ligne"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑफ़लाइन मोड के लिए मॉडल डाउनलोड करना होगा"
          }
        },
        "tr": {
          "stringUnit": {

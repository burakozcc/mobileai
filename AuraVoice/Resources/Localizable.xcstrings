        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-এর জন্য রেকর্ডিং শুরু করুন"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start recording for %@"
          }

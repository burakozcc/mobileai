    "AuraVoice kotan bitti. Yeni dakika eklemek için uygulamayı aç.": {
      "comment": "Siri'nin sesli/yazılı cevabı: kota bitti uyarısı",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نفدت حصتك في AuraVoice. افتح التطبيق لإضافة دقائق جديدة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "AuraVoice কোটা শেষ। নতুন মিনিট যোগ করতে অ্যাপটি খুলুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're out of AuraVoice quota. Open the app to add more minutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se acabó tu cuota de AuraVoice. Abre la app para añadir más minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre quota AuraVoice est épuisé. Ouvrez l’app pour ajouter des minutes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "AuraVoice का कोटा खत्म हो गया। नए मिनट जोड़ने के लिए ऐप खोलें।"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AuraVoice kotan bitti. Yeni dakika eklemek için uygulamayı aç."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AuraVoice 配额已用完。打开应用即可添加新的分钟。"
          }
        }
      }
    },

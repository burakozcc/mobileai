    "İndirme Wi-Fi gerektiriyor; hücresel veriyle indirilmiyor.": {
      "comment": "Hucresel veri engeli hatasi",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب التنزيل شبكة Wi-Fi؛ ولا يتم التنزيل عبر بيانات الجوال."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ডাউনলোডের জন্য Wi-Fi দরকার; সেলুলার ডেটায় ডাউনলোড হয় না।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The download requires Wi-Fi; it doesn't use cellular data."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La descarga requiere Wi-Fi; no se descarga con datos móviles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléchargement nécessite le Wi-Fi ; il ne se fait pas via les données cellulaires."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डाउनलोड के लिए Wi-Fi ज़रूरी है; सेलुलर डेटा से डाउनलोड नहीं होता।"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İndirme Wi-Fi gerektiriyor; hücresel veriyle indirilmiyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载需要 Wi-Fi；不会使用蜂窝数据下载。"
          }
        }
      }
    },

    "Ses ve metin cihazdan hiç çıkmaz. Uçuş modunda dahi çalışır.": {
      "comment": "ONCEKI DENETCIDE HIC YOKTU. Mod seciciinin altindaki gizlilik vaadi satiri - Dashboard'da HER ZAMAN gorunen iki cumleden biri. Ekranin en gorunur Turkce metinlerinden | Dogrulandi: DashboardView.swift:237 Text(viewModel.mode.privacyStatement) - mod secicinin altindaki gizlilik vaadi satiri. Ayrica FormattingAndModelTests.swift:110 bos-degil denetimi var (ceviri sonrasi da gecer).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يغادر الصوت ولا النص جهازك أبدًا. يعمل حتى في وضع الطيران."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অডিও ও লেখা ডিভাইস থেকে একেবারেই বের হয় না। এয়ারপ্লেন মোডেও কাজ করে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio and text never leave your device. It even works in airplane mode."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio y el texto no salen nunca del dispositivo. Funciona incluso en modo avión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio et le texte ne quittent jamais l’appareil. Fonctionne même en mode Avion."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑडियो और टेक्स्ट डिवाइस से बाहर नहीं जाते। एयरप्लेन मोड में भी काम करता है।"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses ve metin cihazdan hiç çıkmaz. Uçuş modunda dahi çalışır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频和文本完全不会离开设备。即使在飞行模式下也能使用。"
          }
        }
      }
    },
    "Ses şifreli kanal üzerinden işleniyor.": {
      "comment": "İşleme kaplamasındaki gizlilik açıklaması (bulut modu); aynı üçlü ifadenin diğer dalı",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتم معالجة الصوت عبر قناة مشفّرة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অডিও এনক্রিপ্টেড চ্যানেলে প্রসেস হচ্ছে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio is processed over an encrypted channel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio se procesa a través de un canal cifrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio est traité via un canal chiffré."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑडियो एन्क्रिप्टेड चैनल से प्रोसेस हो रहा है।"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses şifreli kanal üzerinden işleniyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频通过加密通道处理。"
          }
        }
      }
    },
    "Ses şifreli olarak işlenmek üzere buluta gönderilir.": {
      "comment": "DashboardView.swift:237'de gorunen gizlilik vaadi satiri (online mod).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُرسَل الصوت مشفّرًا إلى السحابة للمعالجة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রসেস করার জন্য অডিও এনক্রিপ্ট করে ক্লাউডে পাঠানো হয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio is encrypted and sent to the cloud for processing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio se envía cifrado a la nube para procesarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio est envoyé chiffré vers le cloud pour y être traité."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑडियो एन्क्रिप्ट करके प्रोसेसिंग के लिए क्लाउड पर भेजा जाता है।"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses şifreli olarak işlenmek üzere buluta gönderilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频将加密后上传到云端处理。"
          }
        }
      }
    },

    "Bu ay kaç dakika kaydın kaldığını söyler.": {
      "comment": "Kısayollar galerisinde eylem açıklaması",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يخبرك بعدد دقائق التسجيل المتبقية هذا الشهر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই মাসে কত মিনিট রেকর্ডিং বাকি আছে তা জানায়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tells you how many recording minutes you have left this month."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dice cuántos minutos de grabación te quedan este mes."

            "value": "Démarrer l’enregistrement pour %@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ के लिए रिकॉर्डिंग शुरू करें"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ için kaydı başlat"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为 %@ 开始录音"
          }
        }
      }
    },
    "%@ için sağlayıcı anahtarı.": {
      "comment": "Başlıktaki ana satır: kurum adı biliniyorsa 'Acme A.Ş. için sağlayıcı anahtarı.'",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مفتاح المزود الخاص بـ %@."

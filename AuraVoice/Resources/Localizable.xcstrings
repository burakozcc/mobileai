      }
    },
    "Kaydı tamamen cihaz içinde işlenecek şekilde başlatır. Ses ve metin cihazdan hiç çıkmaz.": {
      "comment": "Kısayollar galerisinde eylem açıklaması",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدأ التسجيل بحيث تتم معالجته بالكامل على الجهاز. لا يغادر الصوت ولا النص جهازك أبدًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রেকর্ডিং এমনভাবে শুরু করে যাতে পুরো প্রসেসিং ডিভাইসেই হয়। অডিও ও লেখা ডিভাইস থেকে একেবারেই বের হয় না।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starts a recording that's processed entirely on your device. Audio and text never leave your device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia la grabación de forma que se procese por completo en el dispositivo. El audio y el texto nunca salen de él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lance un enregistrement traité entièrement sur l’appareil. L’audio et le texte ne quittent jamais l’appareil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्डिंग इस तरह शुरू करता है कि सब कुछ डिवाइस पर ही प्रोसेस हो। ऑडियो और टेक्स्ट डिवाइस से बाहर नहीं जाते।"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydı tamamen cihaz içinde işlenecek şekilde başlatır. Ses ve metin cihazdan hiç çıkmaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始一段完全在设备上处理的录音。音频和文本不会离开设备。"
          }
        }
      }
    },
    "Kayıt": {

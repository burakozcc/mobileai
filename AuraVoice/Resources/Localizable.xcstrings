    "Aboneliğin geri yüklendi.": {
      "comment": "Geri yukleme basarili uyari govdesi",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمت استعادة اشتراكك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার সাবস্ক্রিপশন পুনরুদ্ধার করা হয়েছে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your subscription has been restored."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha restaurado tu suscripción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre abonnement a été restauré."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका सब्सक्रिप्शन रीस्टोर हो गया।"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aboneliğin geri yüklendi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅已恢复。"
          }
        }
      }
    },
    "Anahtar kaydedilemedi.": {
      "comment": "AuraError açıklaması yoksa kullanılan yedek hata metni (uyarı kartı)",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر حفظ المفتاح."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কী সংরক্ষণ করা যায়নি।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The key couldn't be saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido guardar la clave."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer la clé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुंजी सेव नहीं हो सकी।"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtar kaydedilemedi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存密钥。"
          }
        }
      }
    },
    "Anahtar kuruma kaydedildi (%@). Cihazda saklanmadı.": {
      "comment": "Anahtar sunucuya yazıldıktan sonra çıkan başarı kartı; maskeli anahtar kuyruğunu gösterir",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم حفظ المفتاح لدى المؤسسة (%@). لم يتم حفظه على الجهاز."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কী প্রতিষ্ঠানে সংরক্ষণ করা হয়েছে (%@)। ডিভাইসে রাখা হয়নি।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Key saved to your organization (%@). Not stored on your device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave se ha guardado en la organización (%@). No se ha almacenado en el dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clé enregistrée pour l’entreprise (%@). Elle n’est pas stockée sur l’appareil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुंजी संगठन में सेव हो गई (%@)। डिवाइस पर सेव नहीं हुई।"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtar kuruma kaydedildi (%@). Cihazda saklanmadı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密钥已保存到企业（%@）。未存储在设备上。"
          }
        }
      }
    },
    "Anahtar silinemedi.": {
      "comment": "Silme başarısızsa AuraError açıklaması yerine geçen yedek hata metni",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر حذف المفتاح."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কী মুছে ফেলা যায়নি।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The key couldn't be deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido eliminar la clave."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de supprimer la clé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुंजी डिलीट नहीं हो सकी।"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtar silinemedi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法删除密钥。"
          }
        }
      }
    },
    "Anahtar sunucuda kuruma bağlı olarak saklanır; bu cihaza yazılmaz. Uygulama her durumda AuraVoice sunucusu üzerinden çalışmaya devam eder.": {
      "comment": "Başlık altındaki açıklama paragrafı (Text)",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم حفظ المفتاح على الخادم مرتبطًا بالمؤسسة؛ ولا يتم كتابته على هذا الجهاز. يواصل التطبيق العمل عبر خادم AuraVoice في جميع الأحوال."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কী সার্ভারে আপনার প্রতিষ্ঠানের সঙ্গে যুক্ত অবস্থায় রাখা হয়; এই ডিভাইসে লেখা হয় না। অ্যাপ সব ক্ষেত্রেই AuraVoice সার্ভারের মাধ্যমে চলতে থাকে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The key is stored on the server, tied to your organization; it's never written to this device. The app keeps working through the AuraVoice server either way."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave se guarda en el servidor vinculada a la organización; no se escribe en este dispositivo. La app sigue funcionando en todos los casos a través del servidor de AuraVoice."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé est conservée sur le serveur, rattachée à votre entreprise ; elle n’est pas écrite sur cet appareil. L’app continue de fonctionner via le serveur AuraVoice dans tous les cas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुंजी सर्वर पर आपके संगठन से जुड़ी हुई सेव रहती है; इस डिवाइस पर नहीं लिखी जाती। ऐप हर हाल में AuraVoice सर्वर के ज़रिए ही काम करता रहता है।"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtar sunucuda kuruma bağlı olarak saklanır; bu cihaza yazılmaz. Uygulama her durumda AuraVoice sunucusu üzerinden çalışmaya devam eder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密钥会关联到企业保存在服务器上；不会写入本设备。应用在任何情况下都会继续通过 AuraVoice 服务器运行。"
          }
        }
      }
    },
    "Aramayı temizle": {
      "comment": "Arama temizleme butonunun VoiceOver etiketi. DÜZELTME: önceki envanterde uncertain=true idi; `accessibilityLabel(_ labelKey: LocalizedStringKey)` aşırı yüklemesi mevcut ve doğrudan yazılmış dize sabiti olduğu için burada belirsizlik yok.",

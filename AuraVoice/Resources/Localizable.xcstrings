      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُثبت التذكرة أن الدقائق صادرة من الخادم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "টিকিট প্রমাণ করে যে মিনিট সার্ভার থেকে এসেছে।"
          }

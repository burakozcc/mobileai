        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-এর জন্য প্রোভাইডার কী।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Provider key for %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clave de proveedor para %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clé fournisseur pour %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ के लिए प्रोवाइडर कुंजी।"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ için sağlayıcı anahtarı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的服务商密钥。"
          }
        }
      }
    },
    "%@ kimlik doğrulaması reddetti. Oturumun düşmüş olabilir.": {
      "comment": "Hata metni. `case cloudAuthenticationFailed(provider: String)` (satir 210) -> %@.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض %@ المصادقة. ربما انتهت جلستك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ পরিচয় যাচাই করতে পারেনি। আপনার সেশন শেষ হয়ে থাকতে পারে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ rejected authentication. Your session may have expired."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha rechazado la autenticación. Puede que tu sesión haya caducado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a refusé l’authentification. Votre session a peut-être expiré."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ने ऑथेंटिकेशन अस्वीकार कर दिया। हो सकता है आपका सेशन खत्म हो गया हो।"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kimlik doğrulaması reddetti. Oturumun düşmüş olabilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 拒绝了身份验证。你的登录可能已失效。"
          }
        }
      }
    },

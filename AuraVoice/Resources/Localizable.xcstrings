    "Yetersiz dakika bakiyesi. Gerekli: %@, kalan: %@.": {
      "comment": "String(localized:) ile sarili. AuraFormatSeconds.minutes imzasi dogrulandi (satir 258: `static func minutes(_ seconds: Double) -> String`) - donus tipi String, dolayisiyla iki belirtec de %@. Cevirilerde sira degisecekse %1$@/%2$@ kullanilmali.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رصيد الدقائق غير كافٍ. المطلوب: %@، المتبقي: %@."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মিনিট ব্যালেন্স যথেষ্ট নয়। প্রয়োজন: %@, বাকি: %@।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough minutes. Required: %@, remaining: %@."
          }
        },
        "es": {

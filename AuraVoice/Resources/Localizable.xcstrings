    },
    "Bu ay: %lld/%lld dk": {
      "comment": "Ucretsiz plan ozellik satirinin kullanim detayi (ekranda buyuk harfe cevrilerek gosteriliyor)",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الشهر: %lld/%lld د"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই মাসে: %lld/%lld মিনিট"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This month: %lld/%lld min"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este mes: %lld/%lld min"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce mois-ci : %lld/%lld min"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस महीने: %1$lld/%2$lld मिनट"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ay: %lld/%lld dk"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本月：%lld/%lld 分钟"
          }
        }
      }
    },
    "Bu ayki işleme hakkını kullandın. Pro'ya geçerek aylık dakikanı artırabilirsin.": {
      "comment": "Baslik altindaki aciklama — kota bitti, yenileme tarihi yok",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد استخدمت رصيد المعالجة لهذا الشهر. يمكنك زيادة دقائقك الشهرية بالترقية إلى Pro."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই মাসের প্রসেসিং কোটা শেষ হয়েছে। Pro প্ল্যানে গিয়ে মাসিক মিনিট বাড়াতে পারেন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've used this month's processing allowance. You can upgrade to Pro to increase your monthly minutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has agotado tus minutos de procesamiento de este mes. Puedes aumentar tus minutos mensuales pasando a Pro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez épuisé votre quota de traitement de ce mois-ci. Passez à Pro pour augmenter vos minutes mensuelles."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस महीने की प्रोसेसिंग सीमा खत्म हो गई। Pro पर जाकर हर महीने के मिनट बढ़ा सकते हैं।"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ayki işleme hakkını kullandın. Pro'ya geçerek aylık dakikanı artırabilirsin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本月的处理配额已用完。升级到 Pro 可以增加每月的分钟数。"
          }
        }
      }
    },
    "Bu ayki işleme hakkını kullandın. Ücretsiz dakikaların %@ yenilenecek; beklemek istemiyorsan Pro'ya geçebilirsin.": {
      "comment": "Baslik altindaki aciklama — kota bitti, yenileme tarihi biliniyor",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد استخدمت رصيد المعالجة لهذا الشهر. ستتجدد دقائقك المجانية %@؛ يمكنك الترقية إلى Pro إن لم ترغب في الانتظار."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই মাসের প্রসেসিং কোটা শেষ হয়েছে। আপনার বিনামূল্যের মিনিট %@ নতুন করে যোগ হবে; অপেক্ষা করতে না চাইলে Pro প্ল্যানে যেতে পারেন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've used this month's processing allowance. Your free minutes will renew %@; if you don't want to wait, you can upgrade to Pro."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has agotado tus minutos de procesamiento de este mes. Tus minutos gratuitos se renovarán %@; si no quieres esperar, puedes pasar a Pro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez épuisé votre quota de traitement de ce mois-ci. Vos minutes gratuites seront renouvelées %@ ; si vous ne voulez pas attendre, vous pouvez passer à Pro."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस महीने की प्रोसेसिंग सीमा खत्म हो गई। आपके मुफ़्त मिनट %@ रीन्यू होंगे; इंतज़ार नहीं करना है तो Pro पर जा सकते हैं।"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ayki işleme hakkını kullandın. Ücretsiz dakikaların %@ yenilenecek; beklemek istemiyorsan Pro'ya geçebilirsin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本月的处理配额已用完。免费分钟数将在 %@ 重置；不想等的话可以升级到 Pro。"
          }
        }
      }
    },
    "Bu dakika bileti başka bir cihaz için düzenlenmiş.": {
      "comment": "Hata metni.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تذكرة الدقائق هذه صادرة لجهاز آخر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই মিনিট টিকিট অন্য একটি ডিভাইসের জন্য তৈরি করা হয়েছে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This minute ticket was issued for a different device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este cupón de minutos se ha emitido para otro dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce ticket de minutes a été émis pour un autre appareil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह मिनट टिकट किसी दूसरे डिवाइस के लिए जारी हुआ है।"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dakika bileti başka bir cihaz için düzenlenmiş."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此分钟券是为其他设备签发的。"
          }
        }
      }
    },
    "Bu dakika bileti zaten kullanılmış.": {
      "comment": "Hata metni.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تذكرة الدقائق هذه مستخدمة بالفعل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই মিনিট টিকিট আগেই ব্যবহার করা হয়েছে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This minute ticket has already been redeemed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este cupón de minutos ya se ha canjeado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce ticket de minutes a déjà été utilisé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह मिनट टिकट पहले ही रिडीम हो चुका है।"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dakika bileti zaten kullanılmış."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此分钟券已被使用。"
          }
        }
      }
    },
    "Bu hesap kurumsal anahtar yönetmeye yetkili değil.": {
      "comment": "Yetkisiz hesapta gösterilen bilgilendirme kartı",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الحساب غير مخوّل لإدارة مفتاح المؤسسة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই অ্যাকাউন্টের এন্টারপ্রাইজ কী পরিচালনার অনুমতি নেই।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account isn't authorized to manage the enterprise key."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cuenta no tiene permiso para gestionar la clave corporativa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce compte n’est pas autorisé à gérer la clé d’entreprise."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह अकाउंट एंटरप्राइज़ कुंजी मैनेज करने के लिए अधिकृत नहीं है।"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hesap kurumsal anahtar yönetmeye yetkili değil."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此账户无权管理企业密钥。"
          }
        }
      }
    },
    "Bu kaydın sesi ve metni kalıcı olarak silinir. Dakikan düşülmez.": {
      "comment": "Onay diyaloğunun message kapanışındaki Text",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُحذف صوت هذا التسجيل ونصه نهائيًا. لن تُخصم دقائقك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই রেকর্ডিংয়ের অডিও ও লেখা স্থায়ীভাবে মুছে যাবে। আপনার মিনিট কাটা হবে না।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This recording's audio and text are permanently deleted. No minutes are deducted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio y el texto de esta grabación se eliminan de forma permanente. No se te descuentan minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio et le texte de cet enregistrement seront définitivement supprimés. Vos minutes ne seront pas décomptées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस रिकॉर्डिंग का ऑडियो और टेक्स्ट हमेशा के लिए डिलीट हो जाएगा। आपके मिनट नहीं कटेंगे।"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kaydın sesi ve metni kalıcı olarak silinir. Dakikan düşülmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此录音的音频和文本将被永久删除。不会扣除分钟数。"
          }
        }
      }
    },
    "Bu kayıt için transkript saklanmamış.": {
      "comment": "Segment de ham metin de yokken transkript bölümünde gösterilen bilgi",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُحفظ نص مفرغ لهذا التسجيل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই রেকর্ডিংয়ের ট্রান্সক্রিপ্ট সংরক্ষণ করা হয়নি।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No transcript was saved for this recording."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha guardado ninguna transcripción de esta grabación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune transcription n’a été conservée pour cet enregistrement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस रिकॉर्डिंग का ट्रांसक्रिप्ट सेव नहीं किया गया।"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kayıt için transkript saklanmamış."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此录音未保存转录文本。"
          }
        }
      }
    },
    "Bu kayıt için özet üretilmemiş.": {
      "comment": "Özet üretilmemiş kayıtta gösterilen boş kart açıklaması",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُنشأ ملخص لهذا التسجيل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই রেকর্ডিংয়ের সারাংশ তৈরি করা হয়নি।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No summary was created for this recording."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha generado ningún resumen de esta grabación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun résumé n’a été généré pour cet enregistrement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस रिकॉर्डिंग का सारांश नहीं बना।"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kayıt için özet üretilmemiş."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此录音未生成摘要。"
          }
        }
      }
    },
    "Bu sürümde bilet doğrulama anahtarı tanımlı değil, dolayısıyla özellik kapalı.": {
      "comment": "Info.plist'te açık anahtar yokken gösterilen bilgilendirme kartı",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مفتاح التحقق من التذاكر غير معرّف في هذا الإصدار، لذلك الميزة معطلة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই সংস্করণে টিকিট যাচাইয়ের কী নেই, তাই সুবিধাটি বন্ধ আছে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No ticket verification key is defined in this version, so the feature is off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En esta versión no hay ninguna clave de verificación de cupones definida, así que la función está desactivada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune clé de vérification des tickets n’est définie dans cette version, la fonctionnalité est donc désactivée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस वर्शन में टिकट वेरिफ़िकेशन कुंजी सेट नहीं है, इसलिए यह फ़ीचर बंद है।"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sürümde bilet doğrulama anahtarı tanımlı değil, dolayısıyla özellik kapalı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本未定义分钟券验证密钥，因此该功能已关闭。"
          }
        }
      }
    },

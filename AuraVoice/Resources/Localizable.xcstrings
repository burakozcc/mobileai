    "Henüz kayıt yok. Kayıt butonuna dokunarak başla.": {
      "comment": "Boş kayıt listesi durumu. Yön belirtmemeli (sağdan sola arayüz).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد تسجيلات بعد. اضغط على زر التسجيل للبدء."

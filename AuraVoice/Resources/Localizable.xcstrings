    "İşleme durduruldu. Ses duruyor, istediğin zaman tekrar deneyebilirsin.": {
      "comment": "Kullanıcı işlemeyi iptal ettiğinde hata panelinde (Text(message), satır 451) ve notun failureReason alanında görünür",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إيقاف المعالجة. الصوت محفوظ، ويمكنك إعادة المحاولة متى شئت."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রসেসিং বন্ধ করা হয়েছে। অডিও রয়ে গেছে, যখন খুশি আবার চেষ্টা করতে পারেন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Processing stopped. The audio is still there, so you can try again anytime."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha detenido el procesamiento. El audio se conserva, puedes volver a intentarlo cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Traitement interrompu. L’audio est conservé, vous pouvez réessayer quand vous voulez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोसेसिंग रोक दी गई। ऑडियो मौजूद है, जब चाहें दोबारा कोशिश करें।"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşleme durduruldu. Ses duruyor, istediğin zaman tekrar deneyebilirsin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "处理已停止。音频仍在，随时可以重试。"
          }
        }
      }
    },
    "İşleme hatası: %@": {

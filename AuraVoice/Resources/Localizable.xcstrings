    "Sağlayıcı bu içeriği işlemeyi reddetti (%@). Offline mod bu kısıtlamaya tabi değil.": {
      "comment": "Hata metni. `case cloudRefused(category: String)` (satir 213) -> %@. Yuvaya giren kategori degeri saglayicidan geliyor ve cevrilmiyor - cevirmen notuna yazilmali.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض المزود معالجة هذا المحتوى (%@). الوضع دون اتصال غير خاضع لهذا القيد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রোভাইডার এই কনটেন্ট প্রসেস করতে অস্বীকার করেছে (%@)। অফলাইন মোড এই সীমাবদ্ধতার আওতায় পড়ে না।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The provider refused to process this content (%@). Offline mode isn't subject to this restriction."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proveedor se ha negado a procesar este contenido (%@). El modo sin conexión no está sujeto a esta restricción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fournisseur a refusé de traiter ce contenu (%@). Le mode hors ligne n’est pas soumis à cette restriction."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोवाइडर ने इस कॉन्टेंट को प्रोसेस करने से मना कर दिया (%@)। ऑफ़लाइन मोड पर यह पाबंदी लागू नहीं होती।"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağlayıcı bu içeriği işlemeyi reddetti (%@). Offline mod bu kısıtlamaya tabi değil."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务商拒绝处理此内容（%@）。离线模式不受此限制。"
          }
        }
      }
    },

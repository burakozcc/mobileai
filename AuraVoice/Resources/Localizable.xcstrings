    "Bildirim izni verilmedi. Toplantı hatırlatmaları gönderilemez.": {
      "comment": "Hata metni.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم منح إذن الإشعارات. لا يمكن إرسال تذكيرات الاجتماعات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিজ্ঞপ্তির অনুমতি দেওয়া হয়নি। মিটিং রিমাইন্ডার পাঠানো যাবে না।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notification access wasn't granted. Meeting reminders can't be sent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha concedido el permiso de notificaciones. No se pueden enviar los recordatorios de reuniones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisation des notifications non accordée. Impossible d’envoyer les rappels de réunion."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नोटिफ़िकेशन की अनुमति नहीं मिली। मीटिंग रिमाइंडर नहीं भेजे जा सकते।"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirim izni verilmedi. Toplantı hatırlatmaları gönderilemez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未授予通知权限。无法发送会议提醒。"

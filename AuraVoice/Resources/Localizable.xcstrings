    "Silinecek ses bulunamadı. İşlenmeyi bekleyen kayıtların sesine dokunulmuyor.": {
      "comment": "Ses silme sonrası \"Bilgi\" uyarı kutusu mesajı",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد ملفات صوتية للحذف. لا يتم المساس بصوت التسجيلات التي تنتظر المعالجة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মোছার মতো কোনও অডিও পাওয়া যায়নি। প্রসেসের অপেক্ষায় থাকা রেকর্ডিংগুলোর অডিও অক্ষত রাখা হয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No audio to delete. Audio for recordings waiting to be processed isn't touched."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha encontrado ningún audio que eliminar. No se toca el audio de las grabaciones pendientes de procesar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun audio à supprimer. L’audio des enregistrements en attente de traitement n’est pas touché."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिलीट करने के लिए कोई ऑडियो नहीं मिला। प्रोसेसिंग का इंतज़ार कर रही रिकॉर्डिंग्स के ऑडियो को छुआ नहीं जाता।"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Silinecek ses bulunamadı. İşlenmeyi bekleyen kayıtların sesine dokunulmuyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到可删除的音频。等待处理的录音，其音频不会被删除。"
          }
        }
      }
    },

    "Bilet kaydı güvenli depoya yazılamadı, dakikalar eklenmedi.": {
      "comment": "Hata metni.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذرت كتابة سجل التذكرة في المخزن الآمن، ولم تُضَف الدقائق."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "টিকিটটি সুরক্ষিত স্টোরেজে সংরক্ষণ করা যায়নি, মিনিট যোগ হয়নি।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The ticket record couldn't be written to secure storage, so no minutes were added."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido guardar el cupón en el almacenamiento seguro, no se han añadido los minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer le ticket dans le stockage sécurisé, les minutes n’ont pas été ajoutées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टिकट रिकॉर्ड सुरक्षित स्टोरेज में सेव नहीं हो सका, मिनट नहीं जुड़े।"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilet kaydı güvenli depoya yazılamadı, dakikalar eklenmedi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分钟券记录无法写入安全存储，分钟数未增加。"
          }
        }
      }
    },

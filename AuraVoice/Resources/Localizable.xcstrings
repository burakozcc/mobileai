    "Türkçe için önerilen. Şive, özel isim ve teknik terimde belirgin fark.": {
      "comment": "largeV3Turbo modelinin kart aciklamasi",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "موصى به للغة التركية. فرق واضح في اللهجة وأسماء الأعلام والمصطلحات التقنية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তুর্কি ভাষার জন্য প্রস্তাবিত। আঞ্চলিক উচ্চারণ, নাম ও কারিগরি শব্দে স্পষ্ট পার্থক্য।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recommended for Turkish. Clearly better with accents, proper nouns and technical terms."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recomendado para el turco. Diferencia notable en acentos, nombres propios y términos técnicos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recommandé pour le turc. Différence nette sur les accents, les noms propres et les termes techniques."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तुर्की के लिए सुझाया गया। लहजे, विशेष नामों और तकनीकी शब्दों में साफ़ फ़र्क़।"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Türkçe için önerilen. Şive, özel isim ve teknik terimde belirgin fark."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "推荐用于土耳其语。在口音、专有名词和技术术语上差别明显。"
          }
        }
      }
    },

    "Abonelik altyapısı henüz bağlanmadı.": {
      "comment": "Geri yukleme denendiginde cikan uyari govdesi",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم ربط نظام الاشتراك بعد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সাবস্ক্রিপশন সিস্টেম এখনও যুক্ত করা হয়নি।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The subscription system isn't connected yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La infraestructura de suscripciones aún no está conectada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service d’abonnement n’est pas encore connecté."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सब्सक्रिप्शन सिस्टम अभी कनेक्ट नहीं हुआ है।"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonelik altyapısı henüz bağlanmadı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅功能尚未接入。"
          }
        }
      }
    },
    "Abonelik altyapısı henüz bağlanmadı. Ücretsiz dakikaların her ay yenileniyor.": {
      "comment": "Satin alma denendiginde cikan uyari govdesi",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم ربط نظام الاشتراك بعد. تتجدد دقائقك المجانية كل شهر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সাবস্ক্রিপশন সিস্টেম এখনও যুক্ত করা হয়নি। আপনার বিনামূল্যের মিনিট প্রতি মাসে নতুন করে যোগ হয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The subscription system isn't connected yet. Your free minutes renew every month."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La infraestructura de suscripciones aún no está conectada. Tus minutos gratuitos se renuevan cada mes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service d’abonnement n’est pas encore connecté. Vos minutes gratuites sont renouvelées chaque mois."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सब्सक्रिप्शन सिस्टम अभी कनेक्ट नहीं हुआ है। आपके मुफ़्त मिनट हर महीने रीन्यू होते हैं।"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonelik altyapısı henüz bağlanmadı. Ücretsiz dakikaların her ay yenileniyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅功能尚未接入。你的免费分钟每月都会刷新。"
          }
        }
      }
    },
    "Aboneliği yönet": {
      "comment": "VoiceOver etiketi (ust bardaki tac butonu). DOGRULANDI: accessibilityLabel'in uc asiri yuklemesi var - (Text), (LocalizedStringKey) ve generic <S: StringProtocol>(S). Dize SABITI verildiginde Swift generic olmayani tercih eder, yani LocalizedStringKey secilir ve katalogla cevrilir. Onceki denetci uncertain=true birakmisti; kesin",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إدارة الاشتراك"
          }
        },
        "bn": {
